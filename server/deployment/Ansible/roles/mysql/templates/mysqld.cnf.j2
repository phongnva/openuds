[mysqld]
server-id = {{ mysql_server_id }}
bind-address = 0.0.0.0
port = {{ db_port }}

# Binary logging for Galera compatibility
log-bin = mysql-bin
binlog_format = ROW
default_storage_engine = InnoDB
innodb_autoinc_lock_mode = 2

# Galera settings
wsrep_on = ON
wsrep_provider = {{ wsrep_provider_path | default('/usr/lib/galera/libgalera_smm.so' if ansible_os_family == 'Debian' else '/usr/lib64/galera/libgalera_smm.so') }}
wsrep_cluster_name = {{ galera_cluster_name | quote }}
wsrep_cluster_address = "gcomm://{{ galera_cluster_nodes | join(',') }}"
wsrep_node_name = {{ galera_node_name | default(inventory_hostname) | quote }}
wsrep_node_address = {{ galera_node_address | default(ansible_host | default(inventory_hostname)) | quote }}
wsrep_sst_method = {{ galera_sst_method | default('mariabackup') | quote }}
wsrep_sst_auth = "{{ galera_sst_user }}:{{ galera_sst_password }}"

# Performance
max_connections = 200
innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 2
innodb_log_file_size = 256M
transaction-isolation = READ-COMMITTED

# Galera safety: reject queries when not in PRIMARY state
wsrep_reject_queries = NONE
wsrep_log_conflicts = ON
