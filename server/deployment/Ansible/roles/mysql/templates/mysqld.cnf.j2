[mysqld]
bind-address = 0.0.0.0
port = {{ db_port }}

# Required for Galera
binlog_format = ROW
default_storage_engine = InnoDB
innodb_autoinc_lock_mode = 2

# Galera settings
wsrep_on = ON
wsrep_provider = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_name = "{{ galera_cluster_name }}"
wsrep_cluster_address = "gcomm://{{ galera_cluster_nodes | join(',') }}"
wsrep_node_name = "{{ inventory_hostname }}"
wsrep_node_address = "{{ ansible_host }}"
wsrep_sst_method = {{ galera_sst_method }}
wsrep_sst_auth = "{{ galera_sst_user }}:{{ galera_sst_password }}"

# Better default durability/performance for production
innodb_flush_log_at_trx_commit = 1
max_connections = 200
