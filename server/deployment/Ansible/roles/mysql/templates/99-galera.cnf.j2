[mysqld]
bind-address = {{ mysql_bind_address }}
default_storage_engine = InnoDB
binlog_format = ROW
innodb_autoinc_lock_mode = 2
innodb_flush_log_at_trx_commit = 2
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 500
query_cache_size = 0
query_cache_type = 0

wsrep_on = ON
wsrep_provider = /usr/lib/galera/libgalera_smm.so
wsrep_cluster_name = {{ galera_cluster_name }}
wsrep_cluster_address = gcomm://{% for host in groups['db_servers'] %}{{ hostvars[host].ansible_host | default(host) }}{% if not loop.last %},{% endif %}{% endfor %}
wsrep_node_name = {{ inventory_hostname }}
wsrep_node_address = {{ ansible_host | default(ansible_default_ipv4.address) }}
wsrep_sst_method = {{ galera_sst_method }}
wsrep_sst_auth = {{ galera_sst_user }}:{{ galera_sst_password }}
wsrep_slave_threads = 4

[sst]
progress = /var/lib/mysql/sst-progress.log
