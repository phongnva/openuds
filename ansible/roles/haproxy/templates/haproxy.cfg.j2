# =============================================================================
# HAProxy Configuration - Ansible Managed
# =============================================================================

global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # SSL settings
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  forwardfor
    option  http-server-close
    timeout connect 10s
    timeout client  60s
    timeout server  60s
    timeout http-request 10s
    timeout http-keep-alive 10s
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

# --- Stats ---
listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 10s
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
    stats admin if TRUE

# --- Frontend: HTTPS ---
frontend ft_openuds_https
    bind *:{{ haproxy_frontend_https_port }} ssl crt {{ app_certs_dir }}/haproxy.pem
    mode http
    option forwardfor
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Port {{ haproxy_frontend_https_port }}

    # ACL for health check
    acl is_health path /health

    default_backend bk_openuds_app

# --- Frontend: HTTP redirect to HTTPS ---
frontend ft_openuds_http
    bind *:{{ haproxy_frontend_http_port }}
    mode http
    http-request redirect scheme https code 301

# --- Backend: OpenUDS Application ---
backend bk_openuds_app
    mode http
    balance roundrobin
    option httpchk GET /health
    http-check expect status 200

    cookie SERVERID insert indirect nocache

    server uds-server-01 {{ server_01_ip }}:{{ nginx_uds_port }} check ssl verify none cookie s1 inter 5s fall 3 rise 2
    server uds-server-02 {{ server_02_ip }}:{{ nginx_uds_port }} check ssl verify none cookie s2 inter 5s fall 3 rise 2

# --- Backend: MySQL (TCP mode) ---
listen mysql_cluster
    bind *:3307
    mode tcp
    option mysql-check user haproxy
    balance roundrobin

    server mysql-01 {{ server_01_ip }}:{{ db_port }} check inter 5s fall 3 rise 2
    server mysql-02 {{ server_02_ip }}:{{ db_port }} check inter 5s fall 3 rise 2 backup
