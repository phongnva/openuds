# ===========================================
# UDS Tunnel Server - Environment Variables
# ===========================================

# UDS Server hostname (REQUIRED)
# The hostname/IP of your UDS application server
SERVER_HOST=uds-server.example.com

# SSL Certificate paths inside the container (REQUIRED)
# These should match the volume mount paths
SSL_CRT=/etc/openuds-tunnel/ssl/server.pem
SSL_KEY=/etc/openuds-tunnel/ssl/server.key

# CA Certificate for trusting the UDS server (optional)
# SSL_CA=/etc/openuds-tunnel/ssl/ca.pem

# UDS Tunnel authentication token (REQUIRED)
# Generate this from the UDS admin panel
TUNNEL_TOKEN=your-tunnel-token-here

# MySQL database connection for tunnel registration (REQUIRED)
MYSQL_DATABASE=dbuds
MYSQL_USER=dbuds
MYSQL_PASSWORD=PASSWORD

# Tunnel listening port (optional, default: 8443)
# TUNNEL_PORT=8443

# Whether to verify SSL on UDS server connection (optional, default: false)
# UDS_VERIFY_SSL=false

# Log level: DEBUG, INFO, WARN, ERROR (optional, default: INFO)
# LOG_LEVEL=INFO
