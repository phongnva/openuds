# =============================================================================
# HAProxy Configuration — Managed by Ansible, do not edit manually
# =============================================================================

global
    log /dev/log    local0
    log /dev/log    local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # TLS tuning
    ssl-default-bind-ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-default-server-ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384
    ssl-default-server-options ssl-min-ver TLSv1.2 no-tls-tickets

    # Performance
    maxconn 50000
    tune.ssl.default-dh-param 2048
    tune.bufsize 32768

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    option  tcp-check
    option  redispatch          # on backend failure, pick another server
    retries 2
    timeout connect  5s
    timeout client   2m
    timeout server   2m
    timeout check    3s
    errorfile 408 /dev/null

# =============================================================================
# Stats page (internal, not exposed on VIP)
# =============================================================================
listen stats
    bind *:{{ haproxy_stats_port }}
    mode http
    stats enable
    stats uri /stats
    stats refresh 5s
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_pass }}
    stats show-legends
    stats show-node
    stats admin if TRUE

# =============================================================================
# Frontend — UDS Tunnel (SSL from clients terminated here)
# =============================================================================
frontend tunnel_front
    bind *:{{ haproxy_frontend_port }} ssl crt {{ tunnel_ssl_cert }} key {{ tunnel_ssl_key }} \
         ssl-min-ver TLSv1.2 ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384

    # Source-IP sticky session: pin a client to the same backend for {{ haproxy_stick_expire }}
    # If the backend goes DOWN the entry is removed and the client reconnects via the healthy node
    stick-table  type ip  size 100k  expire {{ haproxy_stick_expire }}  store conn_cur,conn_rate(30s)
    stick on src

    default_backend tunnel_back

# =============================================================================
# Backend — udstunnel nodes (HAProxy → tunnel nodes over TLS)
# =============================================================================
backend tunnel_back
    balance roundrobin

    option ssl-hello-chk        # TCP-level TLS health check
    timeout connect 5s
    timeout server  2m

{% for host in groups['tunnel_servers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:{{ haproxy_backend_port }} \
        ssl verify none \
        check inter {{ haproxy_check_interval }} fall {{ haproxy_backend_fall }} rise {{ haproxy_backend_rise }} \
        weight 1
{% endfor %}
